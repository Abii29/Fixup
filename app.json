{
  "expo": {
    "name": "RN HomeService",
    "slug": "CC-RN-HomeService",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.camelcase.rnhomeservice",
      "buildNumber": "1.0.0",
      "supportsTablet": true,
      "config":{
        "googleMapsApiKey":"AIzaSyDmEJacG-7ZS2JmGGIs9NJRq1Qb3IEZHBg"
      }
    },
    "android": {
      "package": "com.camelcase.rnhomeservice",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "config":{
        "googleMaps":{
          "apiKey":"AIzaSyDmEJacG-7ZS2JmGGIs9NJRq1Qb3IEZHBg"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
